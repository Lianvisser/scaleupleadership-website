---
layout: basis.njk
---
<section class="page-hero">
  <div class="page-hero-text">
    {%- if label %}<div class="label">{{ label }}</div>{% endif %}
    <h1 class="slab-hero">{{ kop or titel }}{% if kop_accent %}{% if kop_accent[0] not in "?!.,:;" %} {% endif %}<span class="q">{{ kop_accent }}</span>{% endif %}</h1>
    <hr class="rule">
    {%- if intro %}<p>{{ intro }}</p>{% endif %}
    {%- if hero_blok %}<div class="hero-extra">{{ hero_blok | safe }}</div>{% endif %}
    {%- if hero_punten or hero_knop %}
    <div class="hero-extra" style="margin-top:22px">
      {%- if hero_punten %}
      <ul class="bk-regels">
        {%- for punt in hero_punten %}
        <li>{{ punt }}</li>
        {%- endfor %}
      </ul>
      {%- endif %}
      {%- if hero_knop %}
      <p><a class="pill-btn" href="{{ hero_knop_url or '/contact/' }}">{{ hero_knop }} <span class="arrow">&rarr;</span></a></p>
      {%- endif %}
    </div>
    {%- endif %}
  </div>
  {%- if afbeelding %}
  <div class="page-hero-cover"><img src="{{ afbeelding }}" alt="{{ kop or titel }}"></div>
  {%- endif %}
  <div class="merk-ring"></div><div class="merk-stip"></div>
</section>

<article class="artikel">
  {{ content | safe }}

  {%- if knop %}
  <div class="artikel-cta">
    <a class="pill-btn" href="{{ knop_url or '/contact/' }}">{{ knop }} <span class="arrow">&rarr;</span></a>
  </div>
  {%- endif %}
</article>
